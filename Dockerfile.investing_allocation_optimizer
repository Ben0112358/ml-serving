FROM python:3.13-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y curl \
    && curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /root/.local/bin/poetry /usr/local/bin/poetry

COPY . .
COPY README.md .

RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --only main

FROM python:3.13-slim
WORKDIR /app

RUN apt-get update && apt-get install -y curl \
    && curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /root/.local/bin/poetry /usr/local/bin/poetry

COPY --from=builder /usr/local /usr/local
COPY --from=builder /app /app
COPY --from=ml_training . /opt/ml-training

ENV PYTHONPATH=/app:$PYTHONPATH

RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --directory /opt/ml-training \
    && pip install --no-cache-dir 'typing_extensions>=4.16.0'

EXPOSE 8000

CMD ["python", "-u", "-m", "uvicorn", "src.ml_serving.investing_allocation_optimizer.serving:app", "--host", "0.0.0.0", "--port", "8000"]
